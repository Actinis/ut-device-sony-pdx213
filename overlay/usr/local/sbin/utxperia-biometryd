#!/usr/bin/env python3
"""Retry Android fingerprint initialization until the bounded startup deadline."""
import signal
import subprocess
import time


def run(command, timeout=40, interval=2):
    deadline = time.monotonic() + timeout
    child = None
    stopping = False

    def stop(signum, frame):
        nonlocal stopping
        stopping = True
        if child is not None and child.poll() is None:
            child.send_signal(signum)

    previous = {sig: signal.signal(sig, stop) for sig in (signal.SIGTERM, signal.SIGINT)}
    try:
        while not stopping:
            child = subprocess.Popen(command)
            if stopping:
                child.terminate()
            status = child.wait()
            child = None
            if stopping:
                return 0
            if status != 78 or time.monotonic() >= deadline:
                return status if status >= 0 else 128 - status
            print('Fingerprint HAL not ready; retrying biometryd initialization', flush=True)
            until = min(deadline, time.monotonic() + interval)
            while not stopping and time.monotonic() < until:
                time.sleep(min(0.1, max(0, until - time.monotonic())))
        return 0
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


if __name__ == '__main__':
    raise SystemExit(run(['/usr/bin/biometryd', 'run']))
