#!/usr/bin/env python3
"""Overlay tilt timing without writing the factory sensor registry."""
import json
import math
import os
from pathlib import Path
import subprocess
import tempfile


def tune(data):
    node=data['sns_tilt']
    if node['owner']!='sns_tilt' or node['enabled']['data']!='1':
        raise ValueError('Unsupported tilt registry')
    for key in ('sample_rate','init_accel_window_time','accel_window_time','angle_threshold'):
        entry=node[key]
        if entry['type']!='flt' or not math.isfinite(float(entry['data'])) or float(entry['data'])<=0:
            raise ValueError('Invalid tilt registry field: '+key)
    for key,value in {'sample_rate':'25.000000','init_accel_window_time':'0.300000','accel_window_time':'0.400000'}.items():
        node[key]['data']=value
    return data


def main():
    target=Path('/android/mnt/vendor/persist/sensors/registry/registry/sns_tilt')
    if os.geteuid()!=0:raise SystemExit('Root required for registry overlay')
    # Never replace the factory file or remount persist. A restart must first
    # remove the previous bind mount, otherwise we'd read our own override.
    if subprocess.run(['mountpoint','-q',str(target)]).returncode==0:
        raise SystemExit('Tilt registry is already a mount point')
    data=tune(json.loads(target.read_text()))
    directory=Path('/var/lib/utxperia/tilt');directory.mkdir(parents=True,exist_ok=True)
    override=directory/'sns_tilt.json'
    fd,name=tempfile.mkstemp(prefix='.sns_tilt-',dir=directory)
    try:
        with os.fdopen(fd,'w') as stream:
            json.dump(data,stream,separators=(',',':'));stream.flush();os.fsync(stream.fileno())
        os.chown(name,1000,1000)
        os.replace(name,override)
    finally:
        Path(name).unlink(missing_ok=True)
    subprocess.run(['mount','--bind',str(override),str(target)],check=True)


if __name__=='__main__':main()
