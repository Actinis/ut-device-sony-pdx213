#!/bin/sh
# USB is deliberately unmanaged by NetworkManager. Restore its DNS fallback
# after the last managed uplink disappears; leave active Wi-Fi DNS alone.
case "$2" in up|down|dhcp4-change|connectivity-change) ;; *) exit 0 ;; esac
ip -4 address show dev usb0 2>/dev/null | grep -q '192.168.77.15/24' || exit 0
ip -4 route show default | grep -q 'via 192.168.77.20 dev usb0' || exit 0
if ip -4 route show default | grep -v ' dev usb0' | grep -q .; then
    exit 0
fi
printf 'nameserver 192.168.77.20\n' > /run/NetworkManager/resolv.conf
