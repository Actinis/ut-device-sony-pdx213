+    // Before Android start, the reader may not exist yet. Keep startup
+    // cancellable so a failed recorder start cannot strand teardown in wait().
+    while (!m_flagExit.load()) {
+        m_audioPipe = open("/dev/socket/micshm", O_WRONLY | O_NONBLOCK);
+        if (m_audioPipe >= 0)
+            break;
+        if (errno != ENXIO && errno != EINTR)
+            break;
+        QThread::msleep(10);
+    }
+    if (m_audioPipe >= 0) {
+        int flags = fcntl(m_audioPipe, F_GETFL);
+        if (flags < 0 || fcntl(m_audioPipe, F_SETFL, flags & ~O_NONBLOCK) < 0) {
+            close(m_audioPipe);
+            m_audioPipe = -1;
+        }
+    }
     if (m_audioPipe < 0)
