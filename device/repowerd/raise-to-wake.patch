 #include "event_loop_handler_registration.h"
 
+namespace repowerd {
+class SensorfwWakeupActivity : public Sensorfw
+{
+public:
+    SensorfwWakeupActivity(std::shared_ptr<Log> const& log,
+                          std::string const& address, std::function<void()> handler)
+        : Sensorfw(log, address, "RaiseToWake", PluginType::WAKEUP), handler{handler} {}
+    ~SensorfwWakeupActivity()
+    {
+        dbus_event_loop.enqueue([this]{ stop(); }).get();
+    }
+    void enable() { dbus_event_loop.enqueue([this]{ start(); }).get(); }
+private:
+    void data_recived_impl() override
+    {
+        std::vector<TimedUnsigned> values;
+        if (!m_socket->read<TimedUnsigned>(values)) return;
+        timespec now{};
+        if (clock_gettime(CLOCK_BOOTTIME, &now)) return;
+        auto const now_us = uint64_t(now.tv_sec) * 1000000 + now.tv_nsec / 1000;
+        for (auto const& value : values)
+        {
+            auto const ts = value.timestamp_;
+            if (!value.value_ || ts <= last_timestamp || ts > now_us || now_us - ts > 2000000) continue;
+            last_timestamp = ts;
+            if (now_us - last_delivery < 500000) continue;
+            last_delivery = now_us;
+            handler();
+        }
+    }
+    std::function<void()> handler;
+    uint64_t last_timestamp{0}, last_delivery{0};
+};
+}
