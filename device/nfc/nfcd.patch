diff --git a/core/src/nfc_tag_mfc.c b/core/src/nfc_tag_mfc.c
new file mode 100644
index 0000000..8c73b21
--- /dev/null
+++ b/core/src/nfc_tag_mfc.c
@@ -0,0 +1,413 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright (C) 2026 Actinis
+ * MIFARE Classic 1K NDEF mapping. No formatting or key discovery.
+ * MAD layout and CRC: NXP AN10787. Public NDEF mapping: NXP AN1304.
+ */
+#include "nfc_tag_p.h"
+#include "nfc_target.h"
+#include "nfc_log.h"
+#include <nfcdef.h>
+#include <string.h>
+
+typedef struct mfc_write MfcWrite;
+static void mfc_write_abort(MfcWrite* write, const char* reason);
+
+typedef struct nfc_tag_mfc {
+    NfcTag tag;
+    NfcTargetSequence* seq;
+    guint tx;
+    guint start;
+    guint state;
+    guint block;
+    guint sector;
+    guint8 mad[32];
+    guint8 sectors[15];
+    guint count;
+    guint index;
+    gboolean writable;
+    MfcWrite* write;
+    GByteArray* bytes;
+} NfcTagMfc;
+typedef NfcTagClass NfcTagMfcClass;
+G_DEFINE_TYPE(NfcTagMfc, nfc_tag_mfc, NFC_TYPE_TAG)
+
+static const guint8 mad_key[6] = {0xa0,0xa1,0xa2,0xa3,0xa4,0xa5};
+static const guint8 ndef_key[6] = {0xd3,0xf7,0xd3,0xf7,0xd3,0xf7};
+/* AN10787 table 11 has CRC 0x89. Its coprocessor preset 0xe3 is
+ * bit-reversed to 0xc7 for this MSB-first polynomial 0x1d algorithm. */
+guint8 nfc_tag_mfc_mad_crc(const guint8* mad)
+{
+    guint8 crc = 0xc7;
+    guint i, bit;
+    for (i=1; i<32; i++) {
+        crc ^= mad[i];
+        for (bit=0; bit<8; bit++) crc = (crc << 1) ^ ((crc & 0x80) ? 0x1d : 0);
+    }
+    return crc;
+}
+
+enum {AUTH_MAD, READ_MAD1, READ_MAD2, READ_GPB, AUTH_NDEF, READ_ACCESS, READ_NDEF};
+static void mfc_next(NfcTagMfc* self);
+
+/* NDEF public Key A may write only data blocks with access condition 000.
+ * Reject corrupt complements, proprietary GPBs and read-only mappings. */
+static gboolean mfc_access_writable(const guint8* p)
+{
+    guint c1=p[7]>>4, c2=p[8]&15, c3=p[8]>>4;
+    return ((p[6]&15)^c1)==15 && ((p[6]>>4)^c2)==15 &&
+        ((p[7]&15)^c3)==15 && !(c1&7) && !(c2&7) && !(c3&7) &&
+        p[9]==0x40;
+}
+
+gboolean nfc_tag_mfc_can_write(NfcTag* tag)
+{
+    return tag && G_TYPE_CHECK_INSTANCE_TYPE(tag,nfc_tag_mfc_get_type()) &&
+        ((NfcTagMfc*)tag)->writable;
+}
+
+
+static void mfc_done(NfcTagMfc* self, gboolean success)
+{
+    if (self->seq) {
+        nfc_target_sequence_free(self->seq);
+        self->seq = NULL;
+    }
+    if (success && self->bytes->len) {
+        GUtilData tlv = {self->bytes->data, self->bytes->len};
+        self->tag.ndef = ndef_rec_new_from_tlv(&tlv);
+    }
+    GDEBUG("Classic NDEF initialization %s", success ? "complete" : "failed");
+    nfc_tag_set_initialized(&self->tag);
+}
+
+/* 1 complete NDEF TLV, 0 incomplete, -1 invalid/terminated without NDEF. */
+static int mfc_tlv(const guint8* data, guint size)
+{
+    guint pos = 0;
+    while (pos < size) {
+        guint type = data[pos++], len;
+        if (!type) continue;
+        if (type == 0xfe) return -1;
+        if (pos == size) return 0;
+        len = data[pos++];
+        if (len == 0xff) {
+            if (size - pos < 2) return 0;
+            len = ((guint)data[pos] << 8) | data[pos+1];
+            pos += 2;
+        }
+        if (len > 720 - pos) return -1;
+        if (len > size - pos) return 0;
+        if (type == 3) return 1;
+        pos += len;
+    }
+    return 0;
+}
+
+static void mfc_response(NfcTarget* target, NFC_TRANSMIT_STATUS status,
+    const void* data, guint len, void* user_data)
+{
+    NfcTagMfc* self = user_data;
+    const guint8* bytes = data;
+    self->tx = 0;
+    GDEBUG("Classic read step=%u status=%u length=%u", self->state, status, len);
+    if ((self->state == AUTH_MAD || self->state == AUTH_NDEF) && len == 1)
+        GDEBUG("Classic authentication status=%u", bytes[0]);
+    if (!self->tag.present) return;
+    if (status != NFC_TRANSMIT_STATUS_OK) { mfc_done(self, FALSE); return; }
+    switch (self->state) {
+    case AUTH_MAD:
+    case AUTH_NDEF:
+        if (len != 1 || bytes[0]) { mfc_done(self, FALSE); return; }
+        if (self->state == AUTH_MAD) self->state = READ_MAD1;
+        else { self->state = READ_ACCESS; self->block = self->sector * 4; }
+        break;
+    case READ_MAD1:
+    case READ_MAD2:
+        if (len != 16) { mfc_done(self, FALSE); return; }
+        memcpy(self->mad + (self->state == READ_MAD1 ? 0 : 16), bytes, 16);
+        self->state++;
+        break;
+    case READ_GPB: {
+        guint8 crc;
+        guint i;
+        if (len != 16 || (bytes[9] & 0x83) != 0x81) {
+            mfc_done(self, FALSE); return;
+        }
+        crc = nfc_tag_mfc_mad_crc(self->mad);
+        if (crc != self->mad[0]) { mfc_done(self, FALSE); return; }
+        for (i=1; i<16; i++) {
+            if (self->mad[2*i] == 0x03 && self->mad[2*i+1] == 0xe1)
+                self->sectors[self->count++] = i;
+        }
+        if (!self->count) { mfc_done(self, FALSE); return; }
+        self->sector = self->sectors[0];
+        self->state = AUTH_NDEF;
+        break;
+    }
+    case READ_ACCESS:
+        if (len != 16) { mfc_done(self,FALSE); return; }
+        if (!self->index) self->writable=mfc_access_writable(bytes);
+        self->state=READ_NDEF;
+        break;
+    case READ_NDEF: {
+        int result;
+        if (len != 16) { mfc_done(self, FALSE); return; }
+        g_byte_array_append(self->bytes, bytes, len);
+        result = mfc_tlv(self->bytes->data, self->bytes->len);
+        if (result) { mfc_done(self, result > 0); return; }
+        self->block++;
+        if ((self->block & 3) == 3) {
+            if (++self->index == self->count) { mfc_done(self, FALSE); return; }
+            self->sector = self->sectors[self->index];
+            self->state = AUTH_NDEF;
+        }
+        break;
+    }
+    }
+    mfc_next(self);
+}
+
+static void mfc_next(NfcTagMfc* self)
+{
+    guint8 cmd[12] = {0};
+    guint len = 2;
+    const NfcParamPollA* poll = &nfc_tag_param(&self->tag)->a;
+    if (self->state == AUTH_MAD || self->state == AUTH_NDEF) {
+        cmd[0] = 0x60;
+        cmd[1] = self->state == AUTH_MAD ? 0 : self->sector * 4;
+        memcpy(cmd+2, poll->nfcid1.bytes + poll->nfcid1.size - 4, 4);
+        memcpy(cmd+6, self->state == AUTH_MAD ? mad_key : ndef_key, 6);
+        len = 12;
+    } else {
+        cmd[0] = 0x30;
+        cmd[1] = self->state == READ_NDEF ? self->block :
+            self->state == READ_ACCESS ? self->sector*4+3 : self->state - READ_MAD1 + 1;
+    }
+    self->tx = nfc_target_transmit(self->tag.target, cmd, len, self->seq,
+        mfc_response, NULL, self);
+    if (!self->tx) mfc_done(self, FALSE);
+}
+
+static gboolean mfc_start(gpointer data)
+{
+    NfcTagMfc* self = data;
+    self->start = 0;
+    mfc_next(self);
+    return G_SOURCE_REMOVE;
+}
+
+static void mfc_cancel(NfcTagMfc* self)
+{
+    if (self->start) { g_source_remove(self->start); self->start = 0; }
+    if (self->tx) {
+        guint tx = self->tx;
+        self->tx = 0;
+        nfc_target_cancel_transmit(self->tag.target, tx);
+    }
+    if (self->seq) { nfc_target_sequence_free(self->seq); self->seq = NULL; }
+}
+static void mfc_gone(NfcTag* tag)
+{
+    nfc_tag_ref(tag);
+    mfc_cancel((NfcTagMfc*)tag);
+    if (((NfcTagMfc*)tag)->write) mfc_write_abort(((NfcTagMfc*)tag)->write,"Card removed");
+    NFC_TAG_CLASS(nfc_tag_mfc_parent_class)->gone(tag);
+    nfc_tag_unref(tag);
+}
+static void mfc_finalize(GObject* object)
+{
+    NfcTagMfc* self = (NfcTagMfc*)object;
+    mfc_cancel(self);
+    g_byte_array_unref(self->bytes);
+    G_OBJECT_CLASS(nfc_tag_mfc_parent_class)->finalize(object);
+}
+static void nfc_tag_mfc_init(NfcTagMfc* self)
+{
+    self->bytes = g_byte_array_new();
+    self->tag.type = NFC_TAG_TYPE_MIFARE_CLASSIC;
+}
+static void nfc_tag_mfc_class_init(NfcTagMfcClass* klass)
+{
+    klass->gone = mfc_gone;
+    G_OBJECT_CLASS(klass)->finalize = mfc_finalize;
+}
+NfcTag* nfc_tag_mfc_new(NfcTarget* target, const NfcParamPollA* poll_a)
+{
+    NfcTagMfc* self;
+    NfcParamPoll poll = {0};
+    if (!target || !poll_a || poll_a->sel_res != 8 || poll_a->nfcid1.size < 4) return NULL;
+    self = g_object_new(nfc_tag_mfc_get_type(), NULL);
+    poll.a = *poll_a;
+    nfc_tag_init_base(&self->tag, target, &poll);
+    self->seq = nfc_target_sequence_new(target);
+    self->start = g_idle_add(mfc_start, self);
+    return &self->tag;
+}
+
+/* Preflight every affected data block before any write. Commit the TLV length
+ * last so an interrupted operation cannot advertise a partial NDEF message. */
+struct mfc_write {
+    NfcTagMfc* tag;
+    NfcTargetSequence* seq;
+    guint tx, state, block_index, blocks, used;
+    guint8 image[720];
+    guint8 before[720];
+    guint8 invalid[16];
+    NfcTagMfcWriteFunc done;
+    void* data;
+};
+enum {W_AUTH, W_ACCESS, W_READ, W_INVALIDATE_AUTH, W_INVALIDATE, W_INVALIDATE_CHECK, W_BODY_AUTH, W_BODY,
+      W_COMMIT_AUTH, W_COMMIT, W_VERIFY_AUTH, W_VERIFY};
+static void mfc_write_next(MfcWrite* w);
+static void mfc_write_abort(MfcWrite* w, const char* reason)
+{
+    NfcTagMfc* self=w->tag;
+    self->write=NULL;
+    if (w->tx) nfc_target_cancel_transmit(self->tag.target,w->tx);
+    nfc_target_sequence_free(w->seq);
+    w->done(&self->tag,!reason,reason,w->data);
+    g_free(w);
+    nfc_tag_unref(&self->tag);
+}
+static guint mfc_write_block(MfcWrite* w)
+{
+    return w->tag->sectors[w->block_index/3]*4+w->block_index%3;
+}
+static gboolean mfc_write_ack(const guint8* p, guint len)
+{
+    /* NXP legacy extension preserves a three-byte ACK response and replaces
+     * its exchange discriminator with NFCSTATUS_SUCCESS. Reject all NACKs. */
+    return (len==1 && p[0]==0x0a) ||
+        (len==3 && p[0]==0 && p[1]==0x0a && (p[2]==0 || p[2]==0x14));
+}
+static void mfc_write_response(NfcTarget* target,NFC_TRANSMIT_STATUS status,
+    const void* data,guint len,void* user_data)
+{
+    MfcWrite* w=user_data;
+    const guint8* p=data;
+    w->tx=0;
+    if (!w->tag->tag.present || status!=NFC_TRANSMIT_STATUS_OK) {
+        mfc_write_abort(w,"Transport failure or card removed"); return;
+    }
+    switch(w->state) {
+    case W_AUTH: case W_INVALIDATE_AUTH: case W_BODY_AUTH: case W_COMMIT_AUTH: case W_VERIFY_AUTH:
+        if (len!=1 || p[0]) {mfc_write_abort(w,"Authentication failed");return;}
+        w->state = w->state==W_AUTH ? W_ACCESS : w->state==W_INVALIDATE_AUTH ? W_INVALIDATE : w->state==W_BODY_AUTH ? W_BODY :
+            w->state==W_COMMIT_AUTH ? W_COMMIT : W_VERIFY;
+        break;
+    case W_ACCESS:
+        if (len!=16 || !mfc_access_writable(p)) {
+            mfc_write_abort(w,"NDEF sector is read-only or has unsupported access conditions");return;
+        }
+        w->state=W_READ;
+        break;
+    case W_READ:
+        if(len!=16) {mfc_write_abort(w,"Short preflight read");return;}
+        memcpy(w->before+w->block_index*16,p,16);
+        if (++w->block_index==w->blocks) {
+            /* Preserve bytes outside the new message, and require the existing
+             * NDEF TLV at offset zero. Proprietary preceding TLVs are untouched. */
+            if(w->before[0]!=3) {mfc_write_abort(w,"Unsupported TLV layout");return;}
+            {
+                guint old_header=w->before[1]==255 ? 4 : 2;
+                guint old_size=old_header==4 ? ((guint)w->before[2]<<8)|w->before[3] : w->before[1];
+                guint old_end=old_header+old_size,i;
+                if(old_end>w->tag->count*48) {
+                    mfc_write_abort(w,"Invalid existing TLV length");return;
+                }
+                /* Growing a message may consume only NULL TLVs and its
+                 * terminator, never a following proprietary TLV or data. */
+                for(i=old_end;i<w->used;i++) {
+                    /* A Terminator ends the TLV stream. Bytes after it are
+                     * unused storage, including tails of previous messages. */
+                    if(w->before[i]==0xfe) break;
+                    if(w->before[i]) {
+                        mfc_write_abort(w,"Following TLV would be overwritten");return;
+                    }
+                }
+            }
+            memcpy(w->image+w->used,w->before+w->used,w->blocks*16-w->used);
+            memcpy(w->invalid,w->before,16);
+            w->invalid[1]=0;w->invalid[2]=0xfe;
+            w->block_index=0;w->state=W_INVALIDATE_AUTH;
+        } else if (w->block_index%3==0) w->state=W_AUTH;
+        break;
+    case W_INVALIDATE:
+        if (!mfc_write_ack(p,len)) {mfc_write_abort(w,"Invalidation not acknowledged");return;}
+        w->state=W_INVALIDATE_CHECK;
+        break;
+    case W_INVALIDATE_CHECK:
+        if(len!=16 || memcmp(p,w->invalid,16)) {
+            mfc_write_abort(w,"Invalidation read-back mismatch");return;
+        }
+        w->block_index=w->blocks>1 ? 1 : 0;
+        w->state=w->blocks>1 ? W_BODY_AUTH : W_COMMIT_AUTH;
+        break;
+    case W_BODY:
+        if (!mfc_write_ack(p,len)) {mfc_write_abort(w,"Write not acknowledged");return;}
+        if (++w->block_index==w->blocks) {
+            w->block_index=0;w->state=W_COMMIT_AUTH;
+        } else if(w->block_index%3==0) w->state=W_BODY_AUTH;
+        break;
+    case W_COMMIT:
+        if (!mfc_write_ack(p,len)) {mfc_write_abort(w,"Commit not acknowledged");return;}
+        w->state=W_VERIFY_AUTH;w->block_index=0;
+        break;
+    case W_VERIFY:
+        if(len!=16 || memcmp(p,w->image+w->block_index*16,16)) {
+            mfc_write_abort(w,"Read-back mismatch");return;
+        }
+        if(++w->block_index==w->blocks) {mfc_write_abort(w,NULL);return;}
+        if(w->block_index%3==0) w->state=W_VERIFY_AUTH;
+        break;
+    }
+    mfc_write_next(w);
+}
+static void mfc_write_next(MfcWrite* w)
+{
+    guint8 cmd[18]={0};guint size=2;
+    guint block=mfc_write_block(w);
+    const NfcParamPollA* poll=&nfc_tag_param(&w->tag->tag)->a;
+    switch(w->state) {
+    case W_AUTH:case W_INVALIDATE_AUTH:case W_BODY_AUTH:case W_COMMIT_AUTH:case W_VERIFY_AUTH:
+        cmd[0]=0x60;cmd[1]=block;
+        memcpy(cmd+2,poll->nfcid1.bytes+poll->nfcid1.size-4,4);
+        memcpy(cmd+6,ndef_key,6);size=12;break;
+    case W_ACCESS:
+        cmd[0]=0x30;cmd[1]=(block/4)*4+3;break;
+    case W_READ:case W_VERIFY:case W_INVALIDATE_CHECK:
+        cmd[0]=0x30;cmd[1]=block;break;
+    default:
+        cmd[0]=0xa0;cmd[1]=block;size=18;
+        memcpy(cmd+2,w->state==W_INVALIDATE ? w->invalid : w->image+w->block_index*16,16);
+        break;
+    }
+    /* Reject every trailer, MAD/manufacturer sector and out-of-range block. */
+    if(block<4 || block>62 || (block%4)==3) {
+        mfc_write_abort(w,"Invalid write plan");return;
+    }
+    w->tx=nfc_target_transmit(w->tag->tag.target,cmd,size,w->seq,
+        mfc_write_response,NULL,w);
+    if(!w->tx) mfc_write_abort(w,"Cannot submit NFC command");
+}
+
+gboolean nfc_tag_mfc_write_ndef(NfcTag* tag,const void* data,guint size,
+    NfcTagMfcWriteFunc done,void* user_data)
+{
+    NfcTagMfc* self;MfcWrite* w;guint header=size<255 ? 2 : 4;
+    if(!nfc_tag_mfc_can_write(tag) || !tag->present || !done || !size || size>716 || !data)
+        return FALSE;
+    self=(NfcTagMfc*)tag;
+    if(self->write || self->seq || self->tx || size+header+1>self->count*48)
+        return FALSE;
+    w=g_new0(MfcWrite,1);w->tag=(NfcTagMfc*)nfc_tag_ref(tag);
+    w->seq=nfc_target_sequence_new(tag->target);w->done=done;w->data=user_data;
+    w->used=size+header+1;w->blocks=(w->used+15)/16;
+    w->image[0]=3;
+    if(size<255) w->image[1]=size;
+    else {w->image[1]=255;w->image[2]=size>>8;w->image[3]=size;}
+    memcpy(w->image+header,data,size);w->image[header+size]=0xfe;
+    self->write=w;
+    mfc_write_next(w);
+    return TRUE;
+}
