+static void dbus_neard_tag_write_done(NfcTag* tag, gboolean success,
+    const char* reason, void* data)
+{
+    GDBusMethodInvocation* call=data;
+    if(success) {
+        g_dbus_method_invocation_return_value(call,NULL);
+        /* Rediscover to refresh both NDEF and neard record objects. */
+        nfc_tag_deactivate(tag);
+    } else g_dbus_method_invocation_return_dbus_error(call,
+        "org.neard.Error.Failed",reason);
+    g_object_unref(call);
+}
+
+static gboolean dbus_neard_tag_handle_write(OrgNeardTag* iface,
+    GDBusMethodInvocation* call,GVariant* attributes,gpointer user_data)
+{
+    DBusNeardTag* self=user_data;
+    const char *type=NULL,*text=NULL,*language="en",*encoding="UTF-8";
+    GByteArray* raw;guint payload,langlen;guint8 header[7];
+    if(!g_variant_lookup(attributes,"Type","&s",&type) || strcmp(type,"Text") ||
+       !g_variant_lookup(attributes,"Representation","&s",&text)) {
+        g_dbus_method_invocation_return_dbus_error(call,
+            "org.neard.Error.InvalidArguments","Only Text NDEF records are supported");
+        return TRUE;
+    }
+    g_variant_lookup(attributes,"Language","&s",&language);
+    g_variant_lookup(attributes,"Encoding","&s",&encoding);
+    langlen=strlen(language);
+    if(strcmp(encoding,"UTF-8") || langlen>63 || !langlen || strlen(text)>700 ||
+        !g_utf8_validate(text,-1,NULL)) {
+        g_dbus_method_invocation_return_dbus_error(call,
+            "org.neard.Error.InvalidArguments","Invalid text, language or encoding");
+        return TRUE;
+    }
+    {
+        guint i;
+        for(i=0;i<langlen;i++) {
+            if(!g_ascii_isalnum(language[i]) && language[i]!='-') {
+                g_dbus_method_invocation_return_dbus_error(call,
+                    "org.neard.Error.InvalidArguments","Language must be an ASCII language tag");
+                return TRUE;
+            }
+        }
+    }
+    payload=1+langlen+strlen(text);raw=g_byte_array_new();
+    header[0]=payload<256 ? 0xd1 : 0xc1;header[1]=1;
+    if(payload<256) {
+        header[2]=payload;header[3]='T';g_byte_array_append(raw,header,4);
+    } else {
+        header[2]=header[3]=0;header[4]=payload>>8;header[5]=payload;
+        header[6]='T';g_byte_array_append(raw,header,7);
+    }
+    header[0]=langlen;g_byte_array_append(raw,header,1);
+    g_byte_array_append(raw,(const guint8*)language,langlen);
+    g_byte_array_append(raw,(const guint8*)text,strlen(text));
+    g_object_ref(call);
+    if(!nfc_tag_mfc_write_ndef(self->tag,raw->data,raw->len,
+        dbus_neard_tag_write_done,call)) {
+        g_object_unref(call);
+        g_dbus_method_invocation_return_dbus_error(call,
+            "org.neard.Error.NotSupported","Tag is busy, read-only, too small or unsupported");
+    }
+    g_byte_array_unref(raw);
+    return TRUE;
+}
+
