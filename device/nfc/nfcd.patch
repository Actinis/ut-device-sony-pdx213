diff --git a/unit/core_tag_mfc/test_core_tag_mfc.c b/unit/core_tag_mfc/test_core_tag_mfc.c
new file mode 100644
index 0000000..02c4b88
--- /dev/null
+++ b/unit/core_tag_mfc/test_core_tag_mfc.c
@@ -0,0 +1,229 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright (C) 2026 Actinis */
+#include "nfc_tag_p.h"
+#include "nfc_target_p.h"
+#include "test_target.h"
+#include <string.h>
+
+static const guint8 uid[] = {1,2,3,4};
+static const guint8 authmad[] = {0x60,0,1,2,3,4,0xa0,0xa1,0xa2,0xa3,0xa4,0xa5};
+static const guint8 authndef[] = {0x60,4,1,2,3,4,0xd3,0xf7,0xd3,0xf7,0xd3,0xf7};
+static const guint8 ok[] = {0};
+static void addread(NfcTarget* t, guint block, const guint8* data, guint len)
+{
+    guint8 cmd[] = {0x30,block};
+    test_target_add_data(t,cmd,sizeof(cmd),data,len);
+}
+static NfcTag* tagnew(NfcTarget* t)
+{
+    NfcParamPollA p = {8,{uid,sizeof(uid)}};
+    return nfc_tag_mfc_new(t,&p);
+}
+static void drain(NfcTag* tag)
+{
+    gint64 until = g_get_monotonic_time()+2000000;
+    while (!(tag->flags & NFC_TAG_FLAG_INITIALIZED) && g_get_monotonic_time()<until)
+        g_main_context_iteration(NULL, FALSE);
+    g_assert_true((tag->flags & NFC_TAG_FLAG_INITIALIZED) != 0);
+}
+static NfcTarget* prepare(int kind)
+{
+    NfcTarget* t = test_target_new_tech(NFC_TECHNOLOGY_A,0);
+    guint8 mad[32] = {0};
+    guint8 trailer[16] = {0};
+    guint8 data[16] = {3,11,0xd1,1,7,0x54,2,0x65,0x6e,0x74,0x65,0x73,0x74,0xfe};
+    mad[0] = 0x00; /* overwritten with independently calculated CRC below */
+    mad[2] = 3;mad[3] = 0xe1;
+    mad[0] = 0xdb;
+    trailer[9] = 0xc1;
+    if (kind == 1) mad[0] ^= 1;
+    if (kind == 2) trailer[9] = 0xc2; /* MAD2 not supported by Classic 1K */
+    test_target_add_data(t,authmad,sizeof(authmad),ok,sizeof(ok));
+    addread(t,1,mad,16);addread(t,2,mad+16,16);addread(t,3,trailer,16);
+    if (kind != 1 && kind != 2) {
+        const guint8 fail[] = {1};
+        test_target_add_data(t,authndef,sizeof(authndef),kind==3?fail:ok,1);
+        if (kind != 3) {
+            if (kind == 4) {data[1]=0xff;data[2]=0xff;data[3]=0xff;}
+            const guint8 access[16]={0,0,0,0,0,0,0x7f,0x07,0x88,0x40};
+            addread(t,7,access,16);
+            addread(t,4,data,kind==5?15:16);
+        }
+    }
+    return t;
+}
+static void scenario(int kind)
+{
+    NfcTarget* t=prepare(kind);NfcTag* tag=tagnew(t);
+    g_assert_nonnull(tag);drain(tag);
+    if (kind) g_assert_null(tag->ndef);else g_assert_nonnull(tag->ndef);
+    g_assert_cmpuint(test_target_tx_remaining(t),==,0);
+    nfc_tag_unref(tag);nfc_target_unref(t);
+}
+static void reference_crc(void)
+{
+    const guint8 mad[32] = {0x89,0x1,0x1,0x8,0x1,0x8,0x1,0x8,0x0,0x0,0x0,0x0,0x0,0x0,0x4,0x0,0x3,0x10,0x3,0x10,0x2,0x10,0x2,0x10,0x0,0x0,0x0,0x0,0x0,0x0,0x11,0x30};
+    g_assert_cmpuint(nfc_tag_mfc_mad_crc(mad),==,0x89);
+}
+static void valid(void){scenario(0);}static void crc(void){scenario(1);}
+static void gpb(void){scenario(2);}static void auth(void){scenario(3);}
+static void oversized(void){scenario(4);}static void shortread(void){scenario(5);}
+static void gone(void)
+{
+    NfcTarget* t=prepare(0);NfcTag* tag=tagnew(t);
+    nfc_target_gone(t);g_assert_false(tag->present);
+    while(g_main_context_iteration(NULL,FALSE));
+    nfc_tag_unref(tag);nfc_target_unref(t);
+}
+static void cancelled(void)
+{
+    NfcTarget* t=prepare(0);NfcTag* tag=tagnew(t);
+    g_main_context_iteration(NULL,FALSE);
+    nfc_tag_unref(tag);
+    while(g_main_context_iteration(NULL,FALSE));
+    nfc_target_unref(t);
+}
+static void txfail(void)
+{
+    NfcTarget* t=test_target_new_tech(NFC_TECHNOLOGY_A,-1);NfcTag* tag=tagnew(t);
+    drain(tag);g_assert_null(tag->ndef);nfc_tag_unref(tag);nfc_target_unref(t);
+}
+
+typedef struct result {gboolean called,ok;} Result;
+static void write_done(NfcTag* t,gboolean ok,const char* reason,void* data)
+{Result* r=data;r->called=TRUE;r->ok=ok;}
+static void addauth(NfcTarget* t,guint block,gboolean success)
+{
+    guint8 cmd[12];const guint8 fail=1;
+    memcpy(cmd,authndef,12);cmd[1]=block;
+    test_target_add_data(t,cmd,12,success?ok:&fail,1);
+}
+static void addwrite(NfcTarget* t,guint block,const guint8* bytes,gboolean success)
+{
+    guint8 cmd[18]={0xa0,block};const guint8 ack[3]={0,success?0x0a:0x00,0x14};
+    memcpy(cmd+2,bytes,16);test_target_add_data(t,cmd,18,ack,3);
+}
+static void write_scenario(int kind)
+{
+    NfcTarget* t=prepare(0);NfcTag* tag=tagnew(t);Result r={0};
+    guint8 old[16]={3,11,0xd1,1,7,0x54,2,0x65,0x6e,0x74,0x65,0x73,0x74,0xfe};
+    guint8 raw[11]={0xd1,1,7,0x54,2,0x65,0x6e,0x74,0x65,0x73,0x58};
+    guint8 fresh[16]={3,11},invalid[16],access[16]={0,0,0,0,0,0,0x7f,7,0x88,0x40};
+    drain(tag);g_assert_true(nfc_tag_mfc_can_write(tag));
+    memcpy(fresh+2,raw,11);fresh[13]=0xfe;
+    memcpy(invalid,old,16);invalid[1]=0;invalid[2]=0xfe;
+    if(kind==1) access[9]=0x43;
+    if(kind==2) access[6]^=1;
+    addauth(t,4,kind!=3);
+    if(kind!=3) {
+        addread(t,7,access,16);
+        if(kind!=1 && kind!=2) {
+            addread(t,4,old,kind==4?15:16);
+            if(kind!=4) {
+                addauth(t,4,TRUE);addwrite(t,4,invalid,kind!=5);
+                if(kind!=5) {
+                    addread(t,4,invalid,16);
+                    addauth(t,4,TRUE);addwrite(t,4,fresh,TRUE);
+                    addauth(t,4,TRUE);addread(t,4,kind==6?old:fresh,16);
+                }
+            }
+        }
+    }
+    g_assert_true(nfc_tag_mfc_write_ndef(tag,raw,11,write_done,&r));
+    g_assert_false(nfc_tag_mfc_write_ndef(tag,raw,11,write_done,&r));
+    gint64 until=g_get_monotonic_time()+2000000;
+    while(!r.called && g_get_monotonic_time()<until)g_main_context_iteration(NULL,FALSE);
+    g_assert_true(r.called);g_assert_cmpint(r.ok,==,!kind);
+    g_assert_cmpuint(test_target_tx_remaining(t),==,0);
+    nfc_tag_unref(tag);nfc_target_unref(t);
+}
+static void write_ok(void){write_scenario(0);}
+static void write_ro(void){write_scenario(1);}
+static void write_access(void){write_scenario(2);}
+static void write_auth(void){write_scenario(3);}
+static void write_short(void){write_scenario(4);}
+static void write_nack(void){write_scenario(5);}
+static void write_verify(void){write_scenario(6);}
+static void write_gone(void)
+{
+    NfcTarget* t=prepare(0);NfcTag* tag=tagnew(t);Result r={0};
+    const guint8 raw[11]={0xd1,1,7,0x54,2,'e','n','t','e','s','t'};
+    drain(tag);addauth(t,4,TRUE);
+    g_assert_true(nfc_tag_mfc_write_ndef(tag,raw,11,write_done,&r));
+    nfc_target_gone(t);g_assert_true(r.called);g_assert_false(r.ok);
+    while(g_main_context_iteration(NULL,FALSE));
+    nfc_tag_unref(tag);nfc_target_unref(t);
+}
+static void write_bounds(void)
+{
+    NfcTarget* t=prepare(0);NfcTag* tag=tagnew(t);Result r={0};guint8 data[720]={0};
+    drain(tag);
+    g_assert_false(nfc_tag_mfc_write_ndef(tag,data,49,write_done,&r));
+    g_assert_false(nfc_tag_mfc_write_ndef(tag,data,0,write_done,&r));
+    g_assert_false(r.called);nfc_tag_unref(tag);nfc_target_unref(t);
+}
+static void write_multi_case(int kind)
+{
+    NfcTarget* t=test_target_new_tech(NFC_TECHNOLOGY_A,0);NfcTag* tag;Result r={0};
+    guint8 mad[32]={0},gpb[16]={0},access[16]={0,0,0,0,0,0,0x7f,7,0x88,0x40};
+    guint8 old[80]={3,11,0xd1,1,7,0x54,2,'e','n','t','e','s','t',0xfe};
+    guint8 raw[67]={0xd1,1,63,'T',2,'e','n'},fresh[80]={3,67},invalid[16];
+    guint i;
+    mad[2]=mad[4]=3;mad[3]=mad[5]=0xe1;mad[0]=nfc_tag_mfc_mad_crc(mad);gpb[9]=0xc1;
+    test_target_add_data(t,authmad,12,ok,1);addread(t,1,mad,16);addread(t,2,mad+16,16);addread(t,3,gpb,16);
+    addauth(t,4,TRUE);addread(t,7,access,16);addread(t,4,old,16);
+    tag=tagnew(t);drain(tag);
+    if(kind==1) old[13]=0xfd;
+    if(kind==2) old[14]=0xfd;
+    memset(raw+7,'x',60);memcpy(fresh+2,raw,67);fresh[69]=0xfe;
+    memcpy(invalid,old,16);invalid[1]=0;invalid[2]=0xfe;
+    addauth(t,4,TRUE);addread(t,7,access,16);
+    for(i=0;i<5;i++) {
+        if(i==3){addauth(t,8,TRUE);addread(t,11,access,16);}
+        addread(t,4+(i/3)*4+i%3,old+i*16,16);
+    }
+    if(kind!=1) {
+    addauth(t,4,TRUE);addwrite(t,4,invalid,TRUE);addread(t,4,invalid,16);
+    addauth(t,5,TRUE);
+    for(i=1;i<5;i++) {
+        if(i==3)addauth(t,8,TRUE);
+        addwrite(t,4+(i/3)*4+i%3,fresh+i*16,TRUE);
+    }
+    addauth(t,4,TRUE);addwrite(t,4,fresh,TRUE);addauth(t,4,TRUE);
+    for(i=0;i<5;i++) {
+        if(i==3)addauth(t,8,TRUE);
+        addread(t,4+(i/3)*4+i%3,fresh+i*16,16);
+    }
+    }
+    g_assert_true(nfc_tag_mfc_write_ndef(tag,raw,67,write_done,&r));
+    gint64 until=g_get_monotonic_time()+2000000;
+    while(!r.called && g_get_monotonic_time()<until)g_main_context_iteration(NULL,FALSE);
+    g_assert_true(r.called);g_assert_cmpint(r.ok,==,kind!=1);g_assert_cmpuint(test_target_tx_remaining(t),==,0);
+    nfc_tag_unref(tag);nfc_target_unref(t);
+}
+static void write_multi(void){write_multi_case(0);}
+static void write_conflict(void){write_multi_case(1);}
+static void write_padding(void){write_multi_case(2);}
+int main(int argc,char** argv)
+{
+    g_test_init(&argc,&argv,NULL);
+    g_test_add_func("/mfc/nxp-reference-crc",reference_crc);
+    g_test_add_func("/mfc/ndef",valid);g_test_add_func("/mfc/mad-crc",crc);
+    g_test_add_func("/mfc/gpb",gpb);g_test_add_func("/mfc/auth-failed",auth);
+    g_test_add_func("/mfc/oversized",oversized);g_test_add_func("/mfc/short-read",shortread);
+    g_test_add_func("/mfc/gone",gone);g_test_add_func("/mfc/cancelled",cancelled);
+    g_test_add_func("/mfc/tx-failed",txfail);
+    g_test_add_func("/mfc/write",write_ok);
+    g_test_add_func("/mfc/write-read-only",write_ro);
+    g_test_add_func("/mfc/write-access-corrupt",write_access);
+    g_test_add_func("/mfc/write-auth",write_auth);
+    g_test_add_func("/mfc/write-short-read",write_short);
+    g_test_add_func("/mfc/write-nack",write_nack);
+    g_test_add_func("/mfc/write-verify",write_verify);
+    g_test_add_func("/mfc/write-gone",write_gone);
+    g_test_add_func("/mfc/write-bounds",write_bounds);
+    g_test_add_func("/mfc/write-cross-sector",write_multi);
+    g_test_add_func("/mfc/write-preserve-following-tlv",write_conflict);
+    g_test_add_func("/mfc/write-grow-after-terminator",write_padding);
+    return g_test_run();
+}
