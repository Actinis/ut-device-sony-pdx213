+/*
+ * Power notification can immediately submit a mode request while CORE_INIT
+ * is still pending. Keep the NCI machine idle until the vendor HAL has
+ * completed coreInitialized and preDiscover. Sending RF_DISCOVER early
+ * prevents SN100 from accepting its required vendor configuration.
+ */
+static
+gboolean
+binder_nfc_adapter_submit_mode_request(
+    NfcAdapter* adapter,
+    NFC_MODE mode)
+{
+    BinderNfcAdapter* self = THIS(adapter);
+
+    if (!self->core_ready) {
+        self->queued_mode = mode;
+        self->mode_queued = TRUE;
+        return TRUE;
+    }
+    return NFC_ADAPTER_CLASS(PARENT_CLASS)->submit_mode_request(adapter, mode);
+}
+
+static
+void
+binder_nfc_adapter_cancel_mode_request(
+    NfcAdapter* adapter)
+{
+    BinderNfcAdapter* self = THIS(adapter);
+
+    if (self->mode_queued) {
+        self->mode_queued = FALSE;
+    } else {
+        NFC_ADAPTER_CLASS(PARENT_CLASS)->cancel_mode_request(adapter);
+    }
+}
+
 /*==========================================================================*
  * NFC HAL I/O
