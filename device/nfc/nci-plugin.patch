+static void nci_target_presence_check_mfc_complete(NfcTarget* target,
+    NFC_TRANSMIT_STATUS status, const void* data, guint len, void* user_data)
+{
+    NciTargetPresenceCheck* check = user_data;
+    /* A Classic READ succeeds only with a full 16-byte data block. */
+    check->done(target, status == NFC_TRANSMIT_STATUS_OK && len == 16,
+        check->user_data);
+}
+
+static guint nci_target_presence_check_mfc(NciTarget* self, NciTargetPresenceCheck* check)
+{
+    const guint8 cmd[] = {0x30, self->mfc_block};
+    return nfc_target_transmit(&self->target, cmd, sizeof(cmd), self->target.sequence,
+        nci_target_presence_check_mfc_complete, nci_target_presence_check_free1, check);
+}
+
+static gboolean nci_target_transmit_finish_mfc(NfcTarget* target, const guint8* data, guint len)
+{
+    nfc_target_transmit_done(target, NFC_TRANSMIT_STATUS_OK, data, len);
+    return TRUE;
+}
