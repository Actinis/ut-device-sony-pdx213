+/* NCI 2.0 controllers may remain in screen-off low-power discovery after
+ * reset. Reader polling requires the host's full-power substate. */
+static void nci_transition_idle_to_discovery_dh_rsp(
+    NCI_REQUEST_STATUS status, const GUtilData* payload, NciTransition* self)
+{
+    if (status == NCI_REQUEST_CANCELLED || !nci_transition_active(self)) return;
+    if (status == NCI_REQUEST_SUCCESS && payload && payload->size >= 1 &&
+        payload->bytes[0] == NCI_STATUS_OK) {
+        GDEBUG("CON_DISCOVERY_PARAM configured");
+        nci_transition_idle_to_discovery_discover(self);
+    } else {
+        GWARN("CON_DISCOVERY_PARAM failed");
+        nci_transition_error(self);
+    }
+}
+
+static void nci_transition_idle_to_discovery_power_rsp(
+    NCI_REQUEST_STATUS status, const GUtilData* payload, NciTransition* self)
+{
+    if (status == NCI_REQUEST_CANCELLED || !nci_transition_active(self)) return;
+    if (status == NCI_REQUEST_SUCCESS && payload && payload->size == 1 &&
+        payload->bytes[0] == NCI_STATUS_OK) {
+        NciSm* sm = nci_transition_sm(self);
+        guint8 config[] = {1, NCI_CONFIG_CON_DISCOVERY_PARAM, 1, 0};
+        /* bit 0: DH polling; bit 1: disable DH+NFCEE listening. NCI 2.0 controls
+         * discovery ownership separately from RF_DISCOVER technology list. */
+        if (sm->op_mode & NFC_OP_MODE_POLL) config[3] |= 1;
+        if (!(sm->op_mode & NFC_OP_MODE_LISTEN)) config[3] |= 2;
+        GDEBUG("CORE_SET_POWER_SUB_STATE ok");
+        if (!nci_transition_send_command_static(self, NCI_GID_CORE,
+            NCI_OID_CORE_SET_CONFIG, config, sizeof(config),
+            nci_transition_idle_to_discovery_dh_rsp)) nci_transition_error(self);
+    } else {
+        GWARN("CORE_SET_POWER_SUB_STATE failed");
+        nci_transition_error(self);
+    }
+}
